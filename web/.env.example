# Bu dosyayı .env.local adıyla kopyala ve değerleri Supabase panelinden doldur:
# Project Settings > API Keys (ya da Data API)

# Tarayıcıya giden değerler (Vercel/Netlify ortam değişkenlerine de bunlar girilir)
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# SADECE veri aktarma scripti için (npm run import-data). Gizli anahtar: RLS'yi atlar.
# Asla VITE_ ile başlatma, asla Vercel/Netlify'a girme, asla paylaşma.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx
